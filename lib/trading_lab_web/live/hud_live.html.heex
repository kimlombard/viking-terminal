<div id="terminal-wrapper" class="flex flex-col h-screen bg-[#131722] text-gray-300">
  <!-- Top Header with your Lot Size/Prob text -->
  <header class="p-2 border-b border-gray-800 flex justify-between items-center text-xs font-mono">
    <div>VIKING_TERMINAL_V1</div>
    <div class="flex gap-4">
      <span class="text-yellow-400">LOT SIZE: 0.0</span>
      <span class="text-yellow-400">PROB: 0.0%</span>
    </div>
  </header>

  <!-- The Charting Engine Hook -->
  <main 
    id="terminal-container" 
    phx-hook="TradingTerminal" 
    class="flex-grow flex flex-col p-2 gap-2"
  >
    <!-- Main Price Chart -->
    <div id="main-chart" class="flex-[2] bg-black/20 rounded-lg border border-gray-800" phx-update="ignore"></div>
    
    <!-- Adaptive BSP / HMM Sub-Pane -->
    <div id="sub-pane-1" class="flex-1 bg-black/20 rounded-lg border border-gray-800" phx-update="ignore"></div>
  </main>
</div>