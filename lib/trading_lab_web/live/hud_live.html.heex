<!-- Remove ID from the wrapper completely -->
<div class="flex flex-col h-screen bg-[#131722] text-gray-300">
  <header class="p-2 border-b border-gray-800 flex justify-between items-center text-xs font-mono">
    <div>VIKING_TERMINAL_V1</div>
    <div class="flex gap-4">
      <span class={if @status == "VIOLATION", do: "text-red-500 font-bold", else: "text-yellow-400"}>
        LOT SIZE: <%= @lot_size %>
      </span>
      <span class="text-yellow-400">
        PROB: <%= :erlang.float_to_binary(@prob, decimals: 1) %>%
      </span>
    </div>
  </header>

  <!-- The hook requires an ID, but we make it highly specific -->
  <main 
    id="viking-terminal-engine" 
    phx-hook="TradingTerminal" 
    phx-update="ignore"
    class="flex-grow flex flex-col p-2 gap-2"
  >
    <!-- Replaced all IDs with data-target attributes -->
    <div data-target="main-chart" class="flex-[3] bg-black/20 rounded-lg border border-gray-800"></div>
    <div data-target="sub-pane-1" class="flex-1 bg-black/20 rounded-lg border border-gray-800"></div>
    <div data-target="sub-pane-2" class="flex-1 bg-black/20 rounded-lg border border-gray-800"></div>
  </main>
</div>