<div class="flex flex-col h-screen bg-[#131722] text-gray-300 overflow-hidden">
  
  <header class="p-2 border-b border-gray-800 flex justify-between items-center text-xs font-mono flex-none h-10">
    <div>VIKING_TERMINAL_V1</div>
    <div class="flex gap-4">
      <span class={if @status == "VIOLATION", do: "text-red-500 font-bold", else: "text-yellow-400"}>
        LOT SIZE: <%= @lot_size %>
      </span>
      <span class="text-yellow-400">
        PROB: <%= :erlang.float_to_binary(@prob, decimals: 1) %>%
      </span>
    </div>
  </header>

  <div class="flex-grow flex p-2 gap-2 min-h-0">
    
    <div class="flex-[4] flex flex-col gap-2 min-w-0 min-h-0">
      
      <div class="flex justify-between items-center bg-[#111827] border border-gray-800 rounded-lg p-4 shadow-md font-sans flex-none h-20">
        <div class="flex items-center space-x-8">
          
          <div class="text-xl font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500">
            VIKING TERMINAL
          </div>

          <div class="flex flex-col">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Account Balance</span>
            <span class="text-lg font-mono text-gray-100">$<%= :erlang.float_to_binary(@balance || 100000.0, [{:decimals, 2}]) %></span>
          </div>

          <% pnl = @pnl || 0.0 %>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Unrealized PnL</span>
            <%= cond do %>
              <% pnl > 0.0 -> %>
                <span class="text-lg font-mono text-green-400">+$<%= :erlang.float_to_binary(pnl, [{:decimals, 2}]) %></span>
              <% 0.0 > pnl -> %>
                <span class="text-lg font-mono text-red-500">-$<%= :erlang.float_to_binary(abs(pnl), [{:decimals, 2}]) %></span>
              <% true -> %>
                <span class="text-lg font-mono text-gray-400">$0.00</span>
            <% end %>
          </div>
        </div>

        <% pos = @position || 0 %>
        <div class="flex items-center px-6 py-2 rounded-lg bg-gray-900 border border-gray-700">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-4">Status:</span>
          <%= cond do %>
            <% pos == 1 -> %>
              <div class="flex items-center text-green-400 font-black tracking-widest animate-pulse">
                <span class="w-2 h-2 rounded-full bg-green-400 mr-2 shadow-[0_0_8px_#4ade80]"></span> LONG ACTIVE
              </div>
            <% pos == -1 -> %>
              <div class="flex items-center text-red-500 font-black tracking-widest animate-pulse">
                <span class="w-2 h-2 rounded-full bg-red-500 mr-2 shadow-[0_0_8px_#ef4444]"></span> SHORT ACTIVE
              </div>
            <% true -> %>
              <div class="flex items-center text-gray-500 font-bold tracking-widest">
                <span class="w-2 h-2 rounded-full bg-gray-600 mr-2"></span> FLAT
              </div>
          <% end %>
        </div>
      </div>

      <main 
        id="viking-terminal-engine-instance-1" 
        phx-hook="TradingTerminal" 
        phx-update="ignore"
        class="flex flex-col gap-0 flex-grow min-w-0 min-h-0 relative"
      >
        <div data-target="main-chart" class="bg-black/20 rounded-t-lg border border-gray-800 min-h-0 overflow-hidden relative" style="flex: 0 0 calc(60% - 3px);"></div>
        
        <div data-resizer="1" class="h-1.5 bg-gray-700 hover:bg-blue-500 cursor-row-resize transition-colors duration-150 relative z-10 w-full flex-none"></div>

        <div data-target="sub-pane-1" class="bg-black/20 border-x border-gray-800 min-h-0 overflow-hidden relative flex-none" style="flex: 0 0 20%;"></div>

        <div data-resizer="2" class="h-1.5 bg-gray-700 hover:bg-blue-500 cursor-row-resize transition-colors duration-150 relative z-10 w-full flex-none"></div>

        <div data-target="sub-pane-2" class="bg-black/20 rounded-b-lg border border-gray-800 min-h-0 overflow-hidden relative flex-none" style="flex: 0 0 20%;"></div>
      </main>

    </div> <aside class="flex-1 bg-black/20 rounded-lg border border-gray-800 flex flex-col min-w-[250px] overflow-hidden min-h-0">
      <div class="p-2 border-b border-gray-800 text-xs font-bold text-gray-400 tracking-widest flex-none">
        VIKING SIGNAL LOG
      </div>
      
      <div class="flex-1 overflow-y-auto p-2 space-y-2 text-xs font-mono">
        <%= for sig <- @signals do %>
          <div class={"flex justify-between p-2 rounded border " <> if(sig.type == "BUY", do: "text-green-400 border-green-900 bg-green-400/10", else: "text-red-400 border-red-900 bg-red-400/10")}>
            <div class="flex flex-col">
              <span class="font-bold text-sm"><%= sig.type %></span>
              <span class="opacity-70"><%= NaiveDateTime.to_string(sig.inserted_at) %></span>
            </div>
            <div class="flex flex-col items-end">
              <span class="text-gray-200"><%= :erlang.float_to_binary(sig.price, decimals: 2) %></span>
              <span class="opacity-70">BSP: <%= :erlang.float_to_binary(sig.bsp, decimals: 1) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </aside>

  </div> </div>